# Copy to .env and fill in. Never commit the real .env file.

# --- LiveKit Cloud (create a free project at https://cloud.livekit.io) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Supabase (create a free project at https://supabase.com) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, from Supabase project settings > Database
SUPABASE_DB_URL=

# --- Twilio (only needed once we wire up real telephony) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- ASR ---
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# --- LLM (via OpenRouter, OpenAI-API-compatible) ---
OPENROUTER_API_KEY=

# --- TTS ---
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# --- Embeddings for RAG (Hugging Face Inference API, read-scoped token) ---
HF_TOKEN=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
